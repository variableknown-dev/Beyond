st input = document.getElementById("message");
const chat = document.getElementById("chat");
const sendButton = document.getElementById("send-button");
const welcome = document.getElementById("welcome");

const sidebar = document.querySelector(".sidebar");
const sidebarToggle = document.getElementById("sidebar-toggle");
const newChat = document.getElementById("new-chat");

let waiting = false;


/* =========================================
   ADD MESSAGE
========================================= */

function addMessage(sender, text, type) {

    const message = document.createElement("div");

    message.className =
        `message ${type}`;


    const senderElement =
        document.createElement("div");

    senderElement.className =
        "sender";

    senderElement.textContent =
        sender;


    const bubble =
        document.createElement("div");

    bubble.className =
        "bubble";

    bubble.textContent =
        text;


    message.appendChild(
        senderElement
    );

    message.appendChild(
        bubble
    );

    chat.appendChild(
        message
    );

    scrollToBottom();
}


/* =========================================
   CREATE STREAMING MESSAGE
========================================= */

function createStreamingMessage() {

    const message =
        document.createElement("div");

    message.className =
        "message kashvi";


    const sender =
        document.createElement("div");

    sender.className =
        "sender";

    sender.textContent =
        "Kashvi";


    const bubble =
        document.createElement("div");

    bubble.className =
        "bubble";

    bubble.textContent =
        "";


    message.appendChild(
        sender
    );

    message.appendChild(
        bubble
    );

    chat.appendChild(
        message
    );

    scrollToBottom();


    return bubble;
}


/* =========================================
   THINKING INDICATOR
========================================= */

function showTyping() {

    removeTyping();


    const message =
        document.createElement("div");

    message.id =
        "typing-message";

    message.className =
        "message kashvi";


    const sender =
        document.createElement("div");

    sender.className =
        "sender";

    sender.textContent =
        "Kashvi";


    const typing =
        document.createElement("div");

    typing.className =
        "thinking";


    /*
        Three animated horizontal lines.
    */

    for (
        let i = 0;
        i < 3;
        i++
    ) {

        const line =
            document.createElement("span");

        typing.appendChild(
            line
        );
    }


    message.appendChild(
        sender
    );

    message.appendChild(
        typing
    );


    chat.appendChild(
        message
    );

    scrollToBottom();
}


/* =========================================
   REMOVE THINKING INDICATOR
========================================= */

function removeTyping() {

    const existing =
        document.getElementById(
            "typing-message"
        );


    if (existing) {

        existing.remove();

    }
}


/* =========================================
   SCROLL
========================================= */

function scrollToBottom() {

    chat.scrollTo({

        top:
            chat.scrollHeight,

        behavior:
            "smooth"

    });
}


/* =========================================
   TEXTAREA AUTO RESIZE
========================================= */

function resizeInput() {

    input.style.height =
        "auto";


    input.style.height =
        Math.min(
            input.scrollHeight,
            160
        ) + "px";
}


input.addEventListener(
    "input",
    resizeInput
);


/* =========================================
   STREAM RESPONSE
========================================= */

async function streamResponse(message) {

    const response =
        await fetch(
            "/api/chat/stream",
            {

                method:
                    "POST",

                headers: {

                    "Content-Type":
                        "application/json"

                },

                body:
                    JSON.stringify({
                        message:
                            message
                    })

            }
        );


    if (!response.ok) {

        throw new Error(
            `Server returned ${response.status}`
        );

    }


    if (!response.body) {

        throw new Error(
            "Streaming is not supported by this browser."
        );

    }


    /*
        IMPORTANT:

        Keep the thinking animation visible
        until the FIRST actual response chunk
        arrives.
    */

    const reader =
        response.body.getReader();


    const decoder =
        new TextDecoder();


    let bubble = null;

    let fullResponse =
        "";


    let firstChunk =
        true;


    while (true) {

        const {
            value,
            done
        } =
            await reader.read();


        if (done) {

            break;

        }


        const chunk =
            decoder.decode(
                value,
                {
                    stream:
                        true
                }
            );


        if (!chunk) {

            continue;

        }


        /*
            First response received.

            Remove "thinking" animation and
            create the actual response bubble.
        */

        if (firstChunk) {

            firstChunk =
                false;

            removeTyping();

            bubble =
                createStreamingMessage();
        }


        fullResponse +=
            chunk;


        if (bubble) {

            bubble.textContent =
                fullResponse;

        }


        scrollToBottom();
    }


    /*
        Safety:
        if the server returned nothing,
        remove the thinking indicator.
    */

    removeTyping();


    return fullResponse;
}


/* =========================================
   SUBMIT
========================================= */

form.addEventListener(
    "submit",
    async (event) => {

        event.preventDefault();


        if (waiting) {

            return;

        }


        const message =
            input.value.trim();


        if (!message) {

            return;

        }


        if (welcome) {

            welcome.remove();

        }


        addMessage(
            "You",
            message,
            "user"
        );


        input.value =
            "";

        resizeInput();


        waiting =
            true;

        sendButton.disabled =
            true;


        /*
            Show thinking animation immediately.
        */

        showTyping();


        try {

            await streamResponse(
                message
            );


        } catch (error) {

            console.error(
                "Kashvi streaming error:",
                error
            );


            removeTyping();


            addMessage(
                "Kashvi",
                "I'm sorry, something went wrong while processing that.",
                "kashvi"
            );

        } finally {

            waiting =
                false;

            sendButton.disabled =
                false;

            input.focus();

        }

    }
);


/* =========================================
   ENTER TO SEND
========================================= */

input.addEventListener(
    "keydown",
    (event) => {

        if (
            event.key === "Enter" &&
            !event.shiftKey
        ) {

            event.preventDefault();

            form.requestSubmit();

        }

    }
);


/* =========================================
   SUGGESTIONS
========================================= */

document.addEventListener(
    "click",
    (event) => {

        const button =
            event.target.closest(
                ".suggestion"
            );


        if (!button) {

            return;

        }


        input.value =
            button.textContent.trim();


        resizeInput();

        input.focus();

    }
);


/* =========================================
   NEW CHAT
========================================= */

newChat.addEventListener(
    "click",
    () => {

        chat.innerHTML =
            "";

        window.location.reload();

    }
);


/* =========================================
   MOBILE SIDEBAR
========================================= */

if (sidebarToggle) {

    sidebarToggle.addEventListener(
        "click",
        () => {

            sidebar.classList.toggle(
                "open"
            );

        }
    );

}
